{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-prototype-builtins": "off"
  },
  "ignorePatterns": ["node_modules/", "logs/", "tmp/"]
}
